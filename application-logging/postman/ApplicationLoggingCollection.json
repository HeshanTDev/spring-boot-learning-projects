{
  "info": {
    "_postman_id": "c2b5a3f1-3333-4b03-9b03-0b2c3d4e5f03",
    "name": "Application Logging API",
    "description": "Combined CRUD collection for the application-logging project. Covers both the Product (/api/v1/products) and User (/api/v1/users) resources in one importable file.\n\nRun the requests inside each folder in order: the \"Create\" request stores the new id into a `productId` / `userId` variable that the read, update and delete requests reuse. Every request asserts its expected status code, including the 400 and 404 cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "description": "CRUD operations for /api/v1/products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response has id, name and price', function () {",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.name).to.eql('Laptop');",
                  "});",
                  "",
                  "pm.environment.set('productId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 1200.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "POST /api/v1/products -> 201 CREATED"
          }
        },
        {
